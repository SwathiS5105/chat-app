# Copy this file to .env and fill in your real values. Never commit .env to GitHub.

PORT=5000

# Paste your MongoDB Atlas connection string here
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/chatapp?retryWrites=true&w=majority

# Paste your Upstash Redis connection string here
REDIS_URL=redis://default:<password>@<endpoint>.upstash.io:<port>

# Any random long string — used to sign JWT tokens
JWT_SECRET=replace_this_with_a_long_random_string

# Your frontend's URL (for CORS) — update when you deploy
CLIENT_URL=http://localhost:5173
